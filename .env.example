# ==============================================================================
# Autonomous AI OS - Environment Configuration Example
# ==============================================================================

PROJECT_NAME="Autonomous AI OS"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autonomous_ai_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autonomous_ai_os

# --- Cache & Message Broker (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=False
MINIO_BUCKET_NAME=ai-os-artifacts

# --- Model Provider API Keys ---
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""

# --- Monitoring & Observability ---
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
