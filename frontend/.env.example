BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_NODE_ENV=development
# form submissions backend
# NEXT_PUBLIC_ONBOARDING_API_URL=http://localhost:8001

# Chatwoot support widget (optional). Set BOTH to enable; leave BOTH unset to
# disable. NEXT_PUBLIC_CHATWOOT_TOKEN is the *public* website token from the
# Chatwoot inbox embed code (not a private API/agent token).
# NEXT_PUBLIC_CHATWOOT_URL=https://app.chatwoot.com
# NEXT_PUBLIC_CHATWOOT_TOKEN=your_public_website_token
