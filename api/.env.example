# Environment Configuration
ENVIRONMENT="local"
# Set to true to apply alembic migrations when the API starts (handy when running
# uvicorn on the host). Docker images already migrate before uvicorn starts.
RUN_MIGRATIONS_ON_STARTUP=false
LOG_LEVEL="DEBUG"

# Change these values if you deploy the backend and frontend
# on any hosting provider with some DNS. Please ensure to 
# provide the URL with scheme like http or https
BACKEND_API_ENDPOINT="http://localhost:8000"
UI_APP_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
REDIS_URL="redis://:redissecret@localhost:6379"

# AWS S3 Configuration
ENABLE_AWS_S3="false"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_BUCKET=""
# S3_REGION=""

# MinIO Configuration if using containerised MinIO instead of
# AWS S3
MINIO_ENDPOINT=localhost:9000
# Full URL (with scheme) that browsers use to reach MinIO. Required.
# Remote deployments behind HTTPS: set to e.g. https://your-server.example.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-audio
MINIO_SECURE=false

# Tracing and Analytics using Langfuse
# Credentials can be set here or per-organization via the UI at /settings.
# Tracing is automatically active when credentials are available.
# LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# LANGFUSE_HOST="https://cloud.langfuse.com"

# TURN Server Configuration (for WebRTC NAT traversal)
# Default coturn provider uses TURN_SECRET for REST-style expiring credentials.
# Cloudflare Realtime TURN is managed; configure the key server-side only.
TURN_PROVIDER=coturn
TURN_HOST=localhost
TURN_SECRET=aios-turn-secret-change-in-production
# TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
# CLOUDFLARE_TURN_KEY_SECRET=your-turn-key-secret
# CLOUDFLARE_TURN_HOST=turn.cloudflare.com
# TURN_CREDENTIAL_TTL=86400
# TURN_PORT=3478
# TURN_TLS_PORT=5349

# STT / Transcription Provider Configuration
SPEACHES_BASE_URL="http://localhost:8790"
SPEACHES_WHISPER_MODEL="Systran/faster-whisper-small" # Options: small, base, tiny, or medium for CPU balance

# ==============================================================================
# Email Management System Configuration (Unified Inbox, AI Rules, Reply Zero)
# ==============================================================================
# Fernet AES token encryption key (32-byte url-safe base64 string).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_CRYPTO_KEY=""

# Gmail OAuth 2.0 Web Application credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/email/settings"

# Microsoft Entra (Azure AD) OAuth application credentials
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT_ID="common"
OUTLOOK_REDIRECT_URI="http://localhost:3000/email/settings"


